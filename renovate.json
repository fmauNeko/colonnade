{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":rebaseStalePrs",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "baseBranchPatterns": ["develop"],
  "packageRules": [
    {
      "description": "GPUI Kit pins exact gpui-pre snapshots, so any update can change GPUI's API: always review it",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["gpui-kit"],
      "automerge": false
    }
  ]
}
